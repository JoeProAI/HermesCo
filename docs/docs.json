{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HermesCo",
  "description": "A one-agent company: Hermes decides, NVIDIA Nemotron screens, Stripe settles, with every dollar gated by a human-in-the-loop Treasury.",
  "colors": {
    "primary": "#E0A35A",
    "light": "#F0C088",
    "dark": "#C8893E"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#0E0E10",
      "light": "#FBF8F1"
    },
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "DM Serif Display",
      "weight": 400
    },
    "body": {
      "family": "Space Grotesk"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "architecture"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/jobs",
              "concepts/pipeline",
              "concepts/fly-machines",
              "concepts/treasury",
              "concepts/safety",
              "concepts/persistence",
              "concepts/auth"
            ]
          },
          {
            "group": "Operations",
            "pages": ["deployment", "configuration"]
          },
          {
            "group": "About",
            "pages": ["credits"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/introduction",
              "api-reference/agent",
              "api-reference/agents",
              "api-reference/agent-machine",
              "api-reference/treasury",
              "api-reference/treasury-decide",
              "api-reference/treasury-deposit",
              "api-reference/treasury-reset"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/hermesco-mark.svg",
    "dark": "/images/hermesco-mark.svg",
    "href": "https://hermesco.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://hermesco.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Command Center",
      "href": "https://hermesco.ai/command"
    }
  },
  "footer": {
    "socials": {
      "website": "https://hermesco.ai"
    }
  }
}
