FROM node:22-bookworm

# Install dependencies for openclaw install script
RUN apt-get update && apt-get install -y curl git && rm -rf /var/lib/apt/lists/*

# Install OpenClaw via official install script (NOT npm - npm has wrong package)
RUN curl -fsSL https://openclaw.ai/install.sh | bash

# Create config directory and set permissions
RUN mkdir -p /home/node/.openclaw && chown -R node:node /home/node

# Write default config for local gateway mode
RUN echo '{"gateway":{"mode":"local"},"memory":{"backend":"qmd"},"skills":{"entries":{}}}' > /home/node/.openclaw/openclaw.json

USER node
WORKDIR /home/node
